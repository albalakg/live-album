---
import { PRICES } from "@snapshare/design/site";
import { appPath } from "../lib/appUrl";
---
<div class="plans">
  <article class="plan reveal">
    <h3>ניסיון</h3>
    <div class="price">חינם</div>
    <p class="price-sub">בלי כרטיס אשראי</p>
    <ul>
      <li>10 קבצים</li>
      <li>48 שעות</li>
      <li>בלי כרטיס אשראי</li>
    </ul>
    <a class="btn btn-ghost" href={appPath("/order?subscription=demo")}>נסו בחינם</a>
  </article>
  <article class="plan featured reveal">
    <h3>קלאסי</h3>
    <div class="price">₪{PRICES.classic}</div>
    <p class="price-sub">תשלום אחד לאירוע, בלי מנוי</p>
    <ul>
      <li>עד 1,000 קבצים</li>
      <li>האירוע נשמר כ-6 חודשים</li>
      <li>מסך חי כלול</li>
    </ul>
    <a class="btn btn-primary" href={appPath("/order?subscription=classic")}>בחירת קלאסיק</a>
  </article>
  <article class="plan reveal">
    <h3>פרימיום</h3>
    <div class="price">₪{PRICES.premium}</div>
    <p class="price-sub">תשלום אחד לאירוע, בלי מנוי</p>
    <ul>
      <li>עד 5,000 קבצים</li>
      <li>האירוע נשמר כשנה</li>
      <li>מסך חי כלול</li>
    </ul>
    <a class="btn btn-ghost" href={appPath("/order?subscription=premium")}>בחירת פרימיום</a>
  </article>
</div>
