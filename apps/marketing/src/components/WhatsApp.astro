---
import { WHATSAPP_PLACEHOLDER, isWhatsappPlaceholder, whatsappHref } from "@snapshare/design/site";

const number = String(import.meta.env.PUBLIC_WHATSAPP_NUMBER || WHATSAPP_PLACEHOLDER).replace(/\D/g, "") || WHATSAPP_PLACEHOLDER;
const placeholder = isWhatsappPlaceholder(number);
const href = whatsappHref(number);
---
<a
  class="wa"
  href={href}
  aria-label={placeholder ? "וואטסאפ — קישור זמני, מספר עדיין לא הוגדר" : "וואטסאפ"}
>
  {placeholder && <span class="wa-tip">וואטסאפ (מספר זמני — placeholder)</span>}
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.05 4.91A9.82 9.82 0 0 0 12.04 2C6.55 2 2.06 6.49 2.06 12c0 1.76.46 3.48 1.34 5L2 22l5.16-1.35A9.93 9.93 0 0 0 12.04 22c5.5 0 9.99-4.49 9.99-10 0-2.67-1.04-5.18-2.98-7.09zm-7 15.15c-1.58 0-3.13-.42-4.48-1.22l-.32-.19-3.06.8.82-2.98-.21-.34a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.42 5.83c.01 4.54-3.69 8.24-8.24 8.24zm4.52-6.16c-.25-.12-1.47-.72-1.7-.81-.22-.08-.39-.12-.55.12-.16.25-.63.81-.77.97-.14.17-.28.19-.53.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.28.37-.42.12-.14.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.55-1.33-.76-1.82-.2-.48-.4-.41-.55-.42h-.47c-.16 0-.42.06-.64.31-.22.25-.84.82-.84 2s.86 2.32.98 2.48c.12.17 1.69 2.58 4.1 3.62.57.25 1.02.4 1.37.51.57.18 1.1.15 1.51.09.46-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.07-.1-.25-.16-.5-.28z"/></svg>
</a>
