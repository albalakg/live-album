---
import { appPath } from "../lib/appUrl";
import BaseLayout from "../layouts/BaseLayout.astro";
import PricingCards from "../components/PricingCards.astro";
import FaqList from "../components/FaqList.astro";
import EventTypeSwitcher from "@snapshare/design/EventTypeSwitcher.vue";
import HowItWorksDemo from "@snapshare/design/HowItWorksDemo.vue";
import LiveAlbumDemo from "@snapshare/design/LiveAlbumDemo.vue";
import { FAQ_ITEMS } from "../data/faq";
import { faqNode, graph, organizationNode, productNode, websiteNode } from "../lib/schema";

const title = "SnapShare | מזכרות, חיבור ואווירה באירוע שלכם";
const description =
  "האורחים סורקים QR ומעלים תמונות מהטלפון. הכל מופיע על המסך באולם, ונשמר באלבום חי אחד. בלי אפליקציה. ניסיון חינם, בלי כרטיס אשראי.";
const schema = graph([
  organizationNode(),
  websiteNode(),
  productNode(),
  faqNode(FAQ_ITEMS),
]);
---
<BaseLayout title={title} description={description} path="/" schema={schema}>
  <section class="hero" id="top">
    <div class="wrap">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="live-mini"><i></i> LIVE</span>
          לכל סוג של אירוע
        </p>
        <h1>מזכרות, חיבור ואווירה <span class="line2">— בזמן אמת.</span></h1>
        <p class="lead">האורחים סורקים QR ומעלים תמונות וסרטונים מהטלפון. הכל מופיע על המסך באולם, ונשמר באלבום חי אחד. בלי אפליקציה, בלי הרשמה לאורחים.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={appPath("/order")}>נסו בחינם <span class="chev" aria-hidden="true">←</span></a>
          <a class="btn btn-on-dark-ghost" href="#how">תראו איך זה עובד</a>
        </div>
        <p class="hero-note"><strong>בלי כרטיס אשראי.</strong> ניסיון חינם · תשלום אחד לאירוע, בלי מנוי.</p>
        <div class="trust-row">
          <span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            מסך חי כלול
          </span>
          <span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            שירות בעברית
          </span>
          <span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            בלי אפליקציה
          </span>
        </div>
      </div>
      <div class="venue" aria-label="הדמיה של מסך חי באירוע">
        <div class="bezel">
          <div class="screen-bar">
            <span class="live-pill"><i></i> LIVE</span>
            <span class="title">החתונה של עמית וגל</span>
          </div>
          <div class="wall" id="hero-wall">
            <figure>
              <img src="/media/photo-night.jpg" alt="עמית וגל בסלפי בערב החתונה" />
              <span class="tag">עכשיו על המסך</span>
            </figure>
            <figure>
              <img src="/media/photo-lounge.jpg" alt="עמית וגל בסלפי על הדשא" />
            </figure>
            <figure>
              <img src="/media/album-02.jpg" alt="נשיקה בשקיעה" />
              <span class="new-tag">חדש</span>
            </figure>
            <figure>
              <img src="/media/album-11.jpg" alt="החתן והכלה באירוע" />
            </figure>
            <figure>
              <img src="/media/album-02.jpg" alt="נשיקה בשקיעה" />
            </figure>
          </div>
          <div class="bezel-foot"><b></b></div>
        </div>
        <p class="caption-float">דוגמה מאלבום אמיתי · החתונה של עמית וגל</p>
      </div>
    </div>
  </section>

  <section id="events">
    <div class="wrap">
      <p class="sec-kicker reveal">לכל סוג של אירוע</p>
      <h2 class="sec-title reveal">אותו רעיון פשוט.<br />האווירה — לפי החגיגה שלכם.</h2>
      <p class="sec-sub reveal">בחרו סוג אירוע ותראו איך המסר משתנה. המוצר נשאר אותו מוצר: האורחים מעלים, המסך חי, והמזכרות נשארות אצל כולם.</p>
      <EventTypeSwitcher client:visible assetBase="/media" />
    </div>
  </section>

  <HowItWorksDemo client:visible assetBase="/media" />
  <LiveAlbumDemo client:visible assetBase="/media" orderHref={appPath("/order")} />

  <section id="promise">
    <div class="wrap">
      <p class="sec-kicker reveal">למה זה עובד</p>
      <h2 class="sec-title reveal">מזכרות. חיבור. אווירה.</h2>
      <p class="sec-sub reveal">שלוש המילים האלה הן כל המוצר — בכל אירוע, בכל גודל.</p>
      <div class="pillars">
        <article class="pillar reveal">
          <div class="pillar-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="8.5" cy="10" r="1.5"/><path d="M3 16l5-4 4 3 3-2 6 5"/></svg>
          </div>
          <h3>מזכרות</h3>
          <p>כל התמונות והסרטונים מתאספים לאלבום אחד. בסוף האירוע אפשר להוריד את הכל, ולשמור את הזיכרון לשנים קדימה.</p>
        </article>
        <article class="pillar reveal">
          <div class="pillar-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="9" r="3.2"/><circle cx="16" cy="10" r="2.6"/><path d="M3.5 19c.8-3 3-4.6 5.5-4.6s4.7 1.6 5.5 4.6"/><path d="M14.5 19c.4-1.8 1.6-3 3.3-3 1.8 0 3 1.2 3.4 3"/></svg>
          </div>
          <h3>חיבור</h3>
          <p>האורחים משתתפים, לא רק צופים. סורקים QR ומעלים מהטלפון — בלי להוריד אפליקציה, ובלי להירשם.</p>
        </article>
        <article class="pillar reveal">
          <div class="pillar-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="4" width="20" height="14" rx="2"/><path d="M8 22h8"/><path d="M12 18v4"/><path d="M8 9.5l2.2 2 4.3-5"/></svg>
          </div>
          <h3>אווירה</h3>
          <p>האלבום החי מוקרן על מסך גדול באולם, בסדר אקראי. רגע שצולם עולה למסך — והאנרגיה באולם עולה איתו.</p>
        </article>
      </div>
      <div class="features reveal">
        <article class="feat">
          <h4>אלבום דיגיטלי חי</h4>
          <p>רצף תמונות וסרטונים בזמן האירוע, מומלץ להקרין על מסך גדול. המסך החי כלול.</p>
        </article>
        <article class="feat">
          <h4>גלריה לשיתוף ולהורדה</h4>
          <p>גלריה ייחודית לכל אירוע, שבה האורחים יכולים לצפות ולהוריד תמונות.</p>
        </article>
        <article class="feat">
          <h4>כרטיס QR מעוצב</h4>
          <p>כל אירוע מקבל קישור ייחודי וכרטיס מעוצב עם QR — מוכן לשולחנות. <a href={appPath("/qr-cards")}>כל העיצובים</a>.</p>
        </article>
        <article class="feat">
          <h4>הגנה חכמה על תמונות</h4>
          <p>בדיקה אוטומטית של תמונות לא הולמות לפני הצגה באלבום. סרטונים אינם נבדקים — ובהגדרות האירוע אפשר להגביל העלאות לתמונות בלבד.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="pricing">
    <div class="wrap">
      <p class="sec-kicker reveal">המסלולים</p>
      <h2 class="sec-title reveal">תשלום אחד לאירוע.<br />בלי מנוי.</h2>
      <p class="sec-sub reveal">שלושה מסלולים ברורים. מתחילים בחינם, בלי כרטיס אשראי. המסך החי כלול. <a href="/pricing">כל הפרטים על המחיר</a>.</p>
      <PricingCards />
    </div>
  </section>

  <section id="faq">
    <div class="wrap">
      <p class="sec-kicker reveal">שאלות נפוצות</p>
      <h2 class="sec-title reveal">התשובות הקצרות.</h2>
      <div class="reveal">
        <FaqList items={FAQ_ITEMS} />
      </div>
      <p class="pricing-note"><a href="/faq">כל השאלות הנפוצות</a></p>
    </div>
  </section>

  <section class="final" id="cta">
    <div class="wrap">
      <h2>מוכנים לראות את האירוע שלכם על המסך?</h2>
      <p>פתחו ניסיון חינם, בלי כרטיס אשראי. תשלום אחד לאירוע, בלי מנוי — כשתהיו מוכנים.</p>
      <a class="btn btn-on-dark" href={appPath("/order")}>נסו בחינם ←</a>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    var sides = document.querySelectorAll("#hero-wall figure img");
    var pool = ["/media/album-10.jpg","/media/album-11.jpg","/media/album-22.jpg","/media/album-23.jpg","/media/photo-hat.jpg","/media/album-13.jpg"];
    var pi = 0;
    setInterval(function () {
      if (sides.length < 3) return;
      var slot = 1 + (pi % (sides.length - 1));
      var img = sides[slot];
      img.style.transition = "opacity .5s";
      img.style.opacity = "0";
      setTimeout(function () {
        img.src = pool[pi % pool.length];
        img.style.opacity = "1";
        pi++;
      }, 400);
    }, 4500);
  })();
</script>
