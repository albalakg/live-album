---
import { PLAN_FACTS } from "@snapshare/design/site";
import { appPath } from "../lib/appUrl";

function priceText(plan: (typeof PLAN_FACTS)[number]) {
  if (plan.priceLabel) return plan.priceLabel;
  return `₪${plan.price}`;
}
---
<div class="plans">
  {PLAN_FACTS.map((plan) => (
    <article class:list={["plan", "reveal", { featured: plan.featured }]}>
      {plan.featured && plan.badge ? <span class="plan-badge">{plan.badge}</span> : null}
      <h3>{plan.nameHe}</h3>
      <div class="price">{priceText(plan)}</div>
      <p class="price-sub">{plan.priceSub}</p>
      <ul>
        {plan.features.map((feature) => (
          <li>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M5 12.5l5 5L20 7.5"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
            <span>{feature}</span>
          </li>
        ))}
      </ul>
      <a
        class:list={["btn", plan.featured ? "btn-primary" : "btn-ghost"]}
        href={appPath(`/order?subscription=${plan.slug}`)}
      >
        {plan.cta}
      </a>
    </article>
  ))}
</div>
