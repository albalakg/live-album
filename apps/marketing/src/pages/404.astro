---
import { appPath } from "../lib/appUrl";
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="העמוד לא נמצא | SnapShare"
  description="העמוד שחיפשתם לא קיים באתר SnapShare."
  path="/404"
  robots="noindex, follow"
>
  <section>
    <div class="wrap">
      <h1 class="sec-title">העמוד לא נמצא</h1>
      <p class="sec-sub">אפשר לחזור לעמוד הבית, או לפתוח ניסיון חינם.</p>
      <p style="margin-top:18px;display:flex;gap:12px;flex-wrap:wrap;">
        <a class="btn btn-primary" href="/">לעמוד הבית</a>
        <a class="btn btn-ghost" href={appPath("/order")}>נסו בחינם</a>
      </p>
    </div>
  </section>
</BaseLayout>
