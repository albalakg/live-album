---
import { parseInline } from "../lib/inline";

interface Props {
  text: string;
}
const { text } = Astro.props;
const parts = parseInline(text);
---
{parts.map((part) => (
  part.type === "strong" ? <strong>{part.text}</strong>
  : part.type === "link" ? <a href={part.href}>{part.text}</a>
  : part.text
))}
