# Vue app origin. Dev default is http://localhost:8080. Leave empty in production (same host).
PUBLIC_APP_URL=http://localhost:8080
PUBLIC_GA4_ID=G-XW53Y5YC3B
# Leave empty until a Meta Pixel id exists. Do not commit a real id here.
PUBLIC_META_PIXEL_ID=
# Gal's WhatsApp. Shown only to logged-in hosts with a paid plan, inside the app.
PUBLIC_WHATSAPP_NUMBER=972528458600
# Visible on the marketing contact form until Gal confirms another address.
PUBLIC_BUSINESS_EMAIL=hello@snapshare-live.com
# laravel (default, existing POST /api/contact) | formspree | web3forms
PUBLIC_CONTACT_PROVIDER=laravel
# Full URL, e.g. https://server.example/api/contact. Empty uses a mailto fallback.
PUBLIC_CONTACT_ENDPOINT=
PUBLIC_FORMSPREE_ID=
PUBLIC_WEB3FORMS_ACCESS_KEY=
